load("@fol_zfc//build:fol.bzl", "fol_library", "fol_proof")
load("@fol_zfc//src/machines/class:defs.bzl", "class_claim")
load("@fol_zfc//src/machines/compress:defs.bzl", "fol_compressed_proof")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//build:prove.bzl", "sys_prove")

genrule(
    name = "compile",
    srcs = [
        "crossing.sys",
        "//library:systems.sys",
    ],
    outs = ["crossing.fol.def"],
    cmd = "$(location //src/tools:sysc) --prelude $(location //library:systems.sys) $(location crossing.sys) $@",
    tools = ["//src/tools:sysc"],
)

fol_library(
    name = "claims",
    header = ":crossing.fol.def",
    deps = [
        "@fol_zfc//math/systems:basic",
        "@fol_zfc//math/systems:reach",
    ],
)

# The claims read back, for review.
genrule(
    name = "read",
    srcs = [
        "crossing.sys",
        ":crossing.fol.def",
        "//library:systems.sys",
    ],
    outs = ["crossing.read.sys"],
    cmd = "$(location //src/tools:sysrender) --prelude $(location //library:systems.sys) $(location crossing.sys) $(location :crossing.fol.def) $@",
    tools = ["//src/tools:sysrender"],
)

# The claims fol-zfc compiled, read back, are the spec, token for token.
cc_test(
    name = "roundtrip",
    args = [
        "--check",
        "--prelude",
        "$(rootpath //library:systems.sys)",
        "$(rootpath crossing.sys)",
        "$(rootpath :crossing.fol.def)",
    ],
    data = [
        "crossing.sys",
        ":claims",
        ":crossing.fol.def",
        "//library:systems.sys",
    ],
    deps = ["//src/tools:sysrender_main"],
)

# The proofs: the sets the class machine separates, then sysprove's lemmas and steps, checked by proof_checker.
SETS = [
    "Crossing.State",
    "Crossing.Input",
    "Crossing.initial",
    "Crossing.step",
    "crossing_safe",
]

sys_prove(
    name = "requests",
    srcs = [
        "crossing.sys",
        ":crossing.fol.def",
        "//library:systems.sys",
    ],
    outs = [s + ".req" for s in SETS],
    arguments = [
        "requests",
        "--prelude",
        "$(location //library:systems.sys)",
        "$(location crossing.sys)",
        "$(location :crossing.fol.def)",
    ] + [x for i, s in enumerate(SETS) for x in ["--req", "%s={out%d}" % (s, i)]],
)

[class_claim(
    name = s + "_gen",
    out_def = s + ".fol.def",
    out_proof = s + ".fol.proof",
    request = s + ".req",
    deps = ["@fol_zfc//lib:base"],
) for s in SETS]

[fol_proof(
    name = s + "_set",
    header = s + ".fol.def",
    proof = s + ".fol.proof",
    deps = [
        "@fol_zfc//lib:base",
        "@fol_zfc//src/machines/class/rows",
    ],
) for s in SETS]

sys_prove(
    name = "proofs",
    visibility = ["//test:__pkg__"],
    srcs = [
        "crossing.sys",
        ":crossing.fol.def",
        "//library:systems.sys",
    ] + [s + ".fol.def" for s in SETS],
    outs = [
        "crossing.lemmas.fol.def",
        "crossing.lemmas.fol.proof",
        "crossing.fol.proof",
        "crossing.needs",
    ],
    arguments = [
        "prove",
        "--prelude",
        "$(location //library:systems.sys)",
        "$(location crossing.sys)",
        "$(location :crossing.fol.def)",
    ] + [x for s in SETS for x in ["--set", "%s=$(location %s.fol.def)" % (s, s)]] + [
        "{out0}",
        "{out1}",
        "{out2}",
        "--project",
        "tests",
        "--needs",
        "{out3}",
    ],
    deps = [
        "@fol_zfc//math/systems:reach",
        "@fol_zfc//math/systems:tuple_facts",
    ],
)

# sysprove's proofs, written smaller by the compression machine before the check.
fol_compressed_proof(
    name = "lemmas",
    header = "crossing.lemmas.fol.def",
    proof = "crossing.lemmas.fol.proof",
    deps = [
        "//test:instances",
        "@fol_zfc//math/systems:tuple_facts",
    ],
)

fol_compressed_proof(
    name = "proved",
    header = ":crossing.fol.def",
    proof = "crossing.fol.proof",
    deps = [
        ":lemmas",
        "//test:instances",
        "@fol_zfc//math/systems:reach",
        "@fol_zfc//math/systems:tuple_facts",
    ] + [":" + s + "_set" for s in SETS],
)

# Every claim of the spec, its lemmas and its sets is on proof_checker's Proved list.
cc_test(
    name = "proved_test",
    args = [
        "$(rootpath :crossing.fol.def)",
        "$(rootpath :proved)",
        "$(rootpath :crossing.lemmas.fol.def)",
        "$(rootpath :lemmas)",
        "$(rootpath //test:instances.fol.def)",
        "$(rootpath //test:instances)",
    ] + [x for s in SETS for x in [
        "$(rootpath :%s.fol.def)" % s,
        "$(rootpath :%s_set)" % s,
    ]],
    data = [
        ":crossing.fol.def",
        ":crossing.lemmas.fol.def",
        ":lemmas",
        ":proved",
        "//test:instances",
        "//test:instances.fol.def",
    ] + [":%s.fol.def" % s for s in SETS] + [":%s_set" % s for s in SETS],
    deps = ["//src/tools:proved_main"],
)
